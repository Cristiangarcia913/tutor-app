{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/calendar.ics",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=900, stale-while-revalidate=86400" },
        { "key": "Content-Type", "value": "text/calendar; charset=utf-8" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/calendar.ics",
      "destination": "/api/calendar"
    },
    {
      "source": "/api/calendar.ics",
      "destination": "/api/calendar"
    },
    {
      "source": "/((?!api/|calendar\\.ics|assets/|_expo/|favicon\\.ico|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
