{
  "name": "tutor-app",
  "version": "1.2.0",
  "description": "Aplicación profesional para la gestión de clases particulares, alumnos y finanzas",
  "author": "Cristian García Del Olmo <cristiangarciadelolmo06@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/Cristiangarcia913/tutor-app#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Cristiangarcia913/tutor-app.git"
  },
  "keywords": [
    "tutor",
    "education",
    "react-native",
    "expo",
    "ios",
    "calendar",
    "finance",
    "classes"
  ],
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build": "expo export -p web",
    "postinstall": "node scripts/patch-expo.js",
    "lint": "eslint .",
    "build:ios": "eas build --platform ios",
    "build:android": "eas build --platform android",
    "build:preview": "eas build --profile preview",
    "submit:ios": "eas submit --platform ios",
    "submit:android": "eas submit --platform android"
  },
  "dependencies": {
    "@expo/vector-icons": "^14.0.0",
    "@react-navigation/bottom-tabs": "^7.0.0",
    "@react-navigation/native": "^7.0.0",
    "expo": "~52.0.0",
    "expo-clipboard": "~7.0.0",
    "expo-constants": "~17.0.0",
    "expo-file-system": "~18.0.0",
    "expo-haptics": "~14.0.0",
    "expo-linking": "~7.0.0",
    "expo-notifications": "~0.29.14",
    "expo-router": "~4.0.0",
    "expo-sharing": "~13.0.0",
    "expo-sqlite": "~15.0.0",
    "expo-status-bar": "~2.0.0",
    "query-string": "^7.1.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "0.76.6",
    "react-native-gesture-handler": "~2.20.2",
    "react-native-reanimated": "~3.16.1",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-web": "~0.19.13"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@expo/ngrok": "^4.1.0",
    "@types/react": "~18.3.12",
    "eslint": "^8.57.0",
    "eslint-config-expo": "~8.0.0",
    "typescript": "^5.3.0"
  },
  "private": true
}
