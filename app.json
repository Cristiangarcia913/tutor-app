{
  "expo": {
    "name": "TutorApp",
    "slug": "tutor-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#4F46E5"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tutorapp.manager",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Se necesita acceso a la cámara para capturar fotos de recibos.",
        "NSPhotoLibraryUsageDescription": "Se necesita acceso a la galería para seleccionar fotos."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#4F46E5"
      },
      "package": "com.tutorapp.manager",
      "versionCode": 1
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#4F46E5"
        }
      ]
    ],
    "scheme": "tutorapp",
    "extra": {
      "eas": {
        "projectId": "tutor-app"
      }
    }
  }
}
